# AWS Region
AWS_REGION="ap-southeast-1"

# AWS Credentials
AWS_ACCOUNT_ID=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# SQS Configuration
AWS_SQS_QUEUE_URL="https://sqs.ap-southeast-1.amazonaws.com/897722701745/DeployQueue.fifo"
SQS_REGION="ap-southeast-1"
SQS_ACCESS_KEY_ID=""
SQS_SECRET_ACCESS_KEY="+f"
SQS_IS_FIFO="true"
SQS_QUEUE_NAME="DeployQueue.fifo"
SQS_URL="https://sqs.ap-southeast-1.amazonaws.com/897722701745/DeployQueue.fifo"
# SQS Status Queue (for deployment status updates)
SQS_STATUS_URL="https://sqs.ap-southeast-1.amazonaws.com/897722701745/DeployStatusQueue.fifo"

# ECS Configuration
AWS_ECS_CLUSTER="your-ecs-cluster"
AWS_ECS_EXECUTION_ROLE_ARN="arn:aws:iam::your-account-id:role/ecsTaskExecutionRole"

# ECR Configuration
AWS_ECR_REPOSITORY="your-account-id.dkr.ecr.ap-southeast-1.amazonaws.com/your-repo"

# VPC Configuration
AWS_VPC_ID="vpc-xxxxxxxx"
AWS_SUBNET_IDS="subnet-xxxxxxxx,subnet-yyyyyyyy"
AWS_SECURITY_GROUP_ID="sg-xxxxxxxx"

# ALB Configuration
AWS_ALB_LISTENER_ARN="arn:aws:elasticloadbalancing:ap-southeast-1:your-account-id:listener/app/your-alb/xxxxxxxx/xxxxxxxx"
# REQUIRED for ECS deployment to work!
AWS_ALB_TARGET_GROUP_ARN="<REQUIRED: your-alb-target-group-arn>"
# Example: AWS_ALB_TARGET_GROUP_ARN="arn:aws:elasticloadbalancing:ap-southeast-1:123456789012:targetgroup/my-tg/abcdef1234567890"

# CloudWatch Configuration
AWS_CLOUDWATCH_LOG_GROUP="/ecs/deployment-worker"

# Domain Configuration
DOMAIN="your-domain.com"

# Cloudflare Configuration
# Cloudflare API token must have DNS:Edit permission for the zone.
# See: https://developers.cloudflare.com/api/tokens/create/
# Required for subdomain assignment
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"
